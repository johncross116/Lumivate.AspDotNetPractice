@model Lumivate.TurtleStore.Models.Turtle
@{
    ViewData["Title"] = Model.Name;
}

<div class="row mt-3">
    <div class="col-md-8">
        <h1>@Model.Name</h1>
        <h4 class="text-muted">@Model.Species</h4>
        <hr />
        <p>@Model.Description</p>
        <h3>@Model.Price.ToString("C")</h3>

        @if (Model.IsAvailable)
        {
            <span class="badge bg-success mb-3">Available</span>
            <br />
            <form asp-controller="Cart" asp-action="Add" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success">Add to Cart</button>
            </form>
        }
        else
        {
            <span class="badge bg-secondary mb-3">Sold Out</span>
        }

        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to Browse</a>
    </div>
</div>
