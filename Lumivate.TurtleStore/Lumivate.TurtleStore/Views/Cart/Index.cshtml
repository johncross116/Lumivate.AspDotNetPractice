@* @model IEnumerable<Lumivate.TurtleStore.Models.CartItem> *@

@{
    ViewData["Title"] = "Shopping Cart";
}

<h1>Shopping Cart</h1>

@* TODO-checkpoint-2: Display the cart items *@
@* Show each item's turtle name, quantity, and price. Example: *@
@*
    @if (!Model.Any())
    {
        <p>Your cart is empty. <a asp-controller="Turtles" asp-action="Index">Browse turtles</a></p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Turtle</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Turtle.Name</td>
                        <td>@item.Quantity</td>
                        <td>$@(item.Turtle.Price * item.Quantity)</td>
                        <td>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="turtleId" value="@item.TurtleId" />
                                <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p><strong>Total: $@Model.Sum(i => i.Turtle.Price * i.Quantity)</strong></p>
    }
*@
