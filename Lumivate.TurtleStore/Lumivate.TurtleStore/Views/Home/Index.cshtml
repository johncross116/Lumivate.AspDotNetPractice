@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-4">
    <h1 class="display-4">Welcome to the Turtle Store!</h1>
    <p class="lead">Your one-stop shop for finding the perfect shelled companion.</p>
    <hr />
    <a asp-controller="Turtles" asp-action="Index" class="btn btn-success btn-lg mt-3">Browse Turtles</a>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Wide Selection</h5>
                <p class="card-text">From Red-Eared Sliders to Sulcata Tortoises, we have a turtle for every home.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Healthy & Happy</h5>
                <p class="card-text">All of our turtles are raised with care and come with a health guarantee.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Expert Support</h5>
                <p class="card-text">Our team of reptile enthusiasts is here to help you every step of the way.</p>
            </div>
        </div>
    </div>
</div>
