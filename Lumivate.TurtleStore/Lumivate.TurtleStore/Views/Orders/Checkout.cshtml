@model Lumivate.TurtleStore.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout</h1>

<div class="row">
    <div class="col-md-6">
        <h4>Your Information</h4>
        <form asp-action="PlaceOrder" method="post">
            <div class="mb-3">
                <label asp-for="CustomerName" class="form-label">Name</label>
                <input asp-for="CustomerName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="CustomerEmail" class="form-label">Email</label>
                <input asp-for="CustomerEmail" class="form-control" type="email" required />
            </div>
            <button type="submit" class="btn btn-success">Place Order</button>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary ms-2">Back to Cart</a>
        </form>
    </div>
    <div class="col-md-6">
        <h4>Order Summary</h4>
        <table class="table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CartItems)
                {
                    <tr>
                        <td>@item.Turtle?.Name</td>
                        <td>@item.Quantity</td>
                        <td>@((item.Turtle?.Price * item.Quantity)?.ToString("C"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2" class="text-end"><strong>Total:</strong></td>
                    <td><strong>@Model.TotalAmount.ToString("C")</strong></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
